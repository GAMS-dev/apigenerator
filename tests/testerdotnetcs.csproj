<!-- .NET 10 C# wrapper test: testerdotnet.cs against the generated c_wrp.cs -->
<!-- explicit Sdk imports, so that intermediate files go to wrptest/ instead of tests/obj/ -->
<Project>

  <PropertyGroup>
    <BaseIntermediateOutputPath>wrptest/obj/testerdotnetcs/</BaseIntermediateOutputPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>testerdotnetcs</AssemblyName>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="testerdotnet.cs" />
    <Compile Include="wrptest/c_wrp.cs" />
    <Compile Include="../include/gamsglobals.cs" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>
